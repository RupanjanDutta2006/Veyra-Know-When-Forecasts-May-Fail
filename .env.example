# ==============================================================================
# VEYRA — FORECAST-BUST SENTINEL: ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment platform.
# All variables are optional and provide safe, production-hardened defaults.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE CREDENTIALS TO THE REPOSITORY.
# ==============================================================================

# --- SERVER & DEPLOYMENT SETTINGS ---
# Host and port binding for FastAPI uvicorn production server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# --- OBSERVABILITY & LOGGING ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Structured JSON-friendly log emission for log aggregators (Datadog, CloudWatch, Papertrail)
STRUCTURED_LOGGING=True
# Standard HTTP security headers (X-Content-Type-Options, X-Frame-Options, HSTS, Referrer-Policy)
ENABLE_SECURITY_HEADERS=True
# Distributed trace & correlation ID header propagation (X-Request-ID)
ENABLE_REQUEST_CORRELATION=True

# --- CORS & ORIGIN SECURITY ---
# Comma-separated list of allowed origins. For separate frontend hosting (e.g. Vercel/Netlify),
# provide your frontend domains: https://your-app.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Set to True ONLY if open wildcard API access without credentials is intentionally desired
CORS_ALLOW_ALL=False

# --- ML MODEL & ARTIFACT DIRECTORY ---
# Directory containing active trained model artifacts (lightgbm_bust_model.joblib, probability_calibrator.joblib, model_metadata.json)
BUILDER2_MODEL_DIR=models/day4

# --- UPSTREAM PROVIDER TIMEOUTS (Seconds) ---
# Bounded HTTP socket/connect timeouts for external services
GEOCODING_TIMEOUT_SECONDS=10
WEATHER_TIMEOUT_SECONDS=25
HISTORICAL_TIMEOUT_SECONDS=15
REFERENCE_TIMEOUT_SECONDS=10

# --- BOUNDED HTTP RETRY & BACKOFF ---
# Upstream transient error (500, 502, 503, 504, 429) retry attempts
MAX_HTTP_RETRIES=2
RETRY_BACKOFF_FACTOR=0.3

# --- LOCATION & GEOCODING CACHE ---
# In-memory bounded LRU cache for geocoded coordinates
CACHE_ENABLED=True
CACHE_MAX_SIZE=1024
CACHE_TTL_SECONDS=3600

# --- WEATHER FORECAST CACHE & SINGLEFLIGHT DEDUPLICATION (Day 17) ---
# Short-lived forecast cache & in-flight request coalescing to eliminate upstream request amplification
WEATHER_CACHE_ENABLED=True
WEATHER_CACHE_MAX_SIZE=512
WEATHER_CACHE_TTL_SECONDS=120
WEATHER_DEDUP_ENABLED=True

# --- ABUSE PROTECTION & RATE LIMITING ---
# Sliding-window in-process rate limiter per client IP
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST_SIZE=30

# --- API BATCH PROCESSING LIMITS ---
MAX_MULTI_LOCATION_BATCH_SIZE=50

# --- FRONTEND CLIENT CONFIGURATION (Optional / Decoupled Frontend) ---
# When frontend is deployed separately from FastAPI (Option A), set the backend API URL:
# VITE_API_BASE_URL=https://api.veyra-forecast.example.com
# When served unified via FastAPI /dashboard (Option B), leave empty or omitted.
# VITE_API_BASE_URL=
